{
  "expo": {
    "name": "Educar para Transformar",
    "slug": "educar-para-transformar",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "educar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.edu.educarparatransformar.tutores"
    },
    "android": {
      "package": "ar.edu.educarparatransformar.tutores",
      "adaptiveIcon": {
        "backgroundColor": "#1f4e79"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La app accede a tus fotos para que puedas adjuntar el comprobante de transferencia.",
          "cameraPermission": "La app usa la cámara para que puedas fotografiar el comprobante de transferencia."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para leer el QR del carnet en el micro y en el comedor, y para fotografiar comprobantes de transferencia."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1f4e79",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://transformar-para-educar.up.railway.app"
    }
  }
}
