  authorId   Int
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  titulo     String
  contenido  String
  targetRole AnnouncementTarget @default(ALL)
  createdAt  DateTime           @default(now())

  @@index([targetRole])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo    String
  contenido String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  sender     User     @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId Int
  receiver   User     @relation("MsgReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  contenido  String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
}

model Activity {
  id           Int          @id @default(autoincrement())
  docenteId    Int
  docente      User         @relation("ActivityDocente", fields: [docenteId], references: [id], onDelete: Cascade)
  materia      String
  titulo       String
  descripcion  String
  tipo         ActivityType @default(TAREA)
  fechaEntrega DateTime
  maxScore     Int          @default(10)
  fileUrl      String?
  createdAt    DateTime     @default(now())

  submissions Submission[]

  @@index([materia])
  @@index([fechaEntrega])
}

model Submission {
  id           Int              @id @default(autoincrement())
  activityId   Int
  activity     Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  estudianteId Int
  estudiante   User             @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  textContent  String?
  fileUrl      String?
  status       SubmissionStatus @default(ENTREGADO)
  score        Int?
  feedback     String?
  entregadoEn  DateTime         @default(now())
  calificadoEn DateTime?

  @@unique([activityId, estudianteId])
  @@index([estudianteId])
}

model ForumPost {
  id        Int          @id @default(autoincrement())
  authorId  Int
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  materia   String
  titulo    String
  contenido String
  isPinned  Boolean      @default(false)
  createdAt DateTime     @default(now())

  replies   ForumReply[]

  @@index([materia])
  @@index([createdAt])
}

model ForumReply {
  id        Int       @id @default(autoincrement())
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  contenido String
  createdAt DateTime  @default(now())

  @@index([postId])
}

model Inscription {
  id               Int              @id @default(autoincrement())
  nombreTutor      String
  emailTutor       String
  telefonoTutor    String
  nombreEstudiante String
  nivel            String
  curso            String
  mensaje          String?
  status           ModerationStatus @default(PENDIENTE)
  notaAdmin        String?
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?

  @@index([status])
  @@index([createdAt])
}

/// Reseñas públicas del sitio institucional (no requieren login).
/// Renombrado desde `Opinion` para alinearse con la nomenclatura del dominio.
/// `@@map("Opinion")` conserva la tabla física: el renombre NO migra datos.
model OpinionPublica {
  id         Int              @id @default(autoincrement())
  nombre     String?
  rol        String
  texto      String
  rating     Int
  status     ModerationStatus @default(PENDIENTE)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([createdAt])
  @@map("Opinion")
}

model EmploymentApplication {
  id         Int              @id @default(autoincrement())
  nombre     String
  email      String
  puesto     String
  cvUrl      String?
  status     ModerationStatus @default(PENDIENTE)
  notaAdmin  String?
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

model StudyPlan {
  id         Int      @id @default(autoincrement())
  docenteId  Int
  docente    User     @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  materia    String
  titulo     String
  objetivos  String
  contenidos String
  fileUrl    String?
  createdAt  DateTime @default(now())

  @@index([materia])
}

// ============================================================
// CARNET DIGITAL Y CONTROL DE ACCESO POR QR
// ============================================================

enum PuntoControl {
  TRANSPORTE
  COMEDOR
}

enum ResultadoAcceso {
  PERMITIDO
  DENEGADO_CODIGO_INVALIDO
  DENEGADO_CODIGO_REUTILIZADO
  DENEGADO_CREDENCIAL_REVOCADA
  DENEGADO_ALUMNO_INACTIVO
  DENEGADO_SIN_SERVICIO
  DENEGADO_OTRO_RECORRIDO
}

/// Credencial digital del alumno.
///
/// `secreto` es la clave HMAC con la que el teléfono deriva el código rotativo
/// (TOTP, RFC 6238). Se entrega una sola vez a la app del tutor por HTTPS y ahí
/// queda en el almacenamiento seguro del dispositivo.
///
/// `version` permite revocar: al reemitir la credencial se genera un secreto
/// nuevo y los códigos del teléfono viejo dejan de validar de inmediato. Es la
/// respuesta a un teléfono perdido o a una credencial compartida.
model CredencialDigital {
  id           Int       @id @default(autoincrement())
  alumnoId     Int       @unique
  alumno       Alumno    @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  secreto      String
  version      Int       @default(1)
  activa       Boolean   @default(true)
  emitidaEn    DateTime  @default(now())
  revocadaEn   DateTime?
  motivoRevocacion String?
  emitidaPorId Int?
  emitidaPor   User?     @relation("CredencialEmitidaPor", fields: [emitidaPorId], references: [id], onDelete: SetNull)

  accesos RegistroAcceso[]

  @@index([activa])
}

/// Bitácora de escaneos, tanto los permitidos como los rechazados.
///
/// Se registran también los rechazos: si alguien intenta entrar al comedor sin
/// servicio contratado, o reutiliza un código, Administración tiene que poder
/// verlo. Un registro que sólo guarda los éxitos no sirve para auditar.
///
/// `@@unique([credencialId, punto, contador])` es la defensa contra repetición:
/// un mismo código no puede usarse dos veces en el mismo punto de control. Lo
/// garantiza el motor, no la aplicación.
model RegistroAcceso {
  id            Int             @id @default(autoincrement())
  credencialId  Int?
  credencial    CredencialDigital? @relation(fields: [credencialId], references: [id], onDelete: SetNull)
  alumnoId      Int?
  alumno        Alumno?         @relation(fields: [alumnoId], references: [id], onDelete: SetNull)
  punto         PuntoControl
  resultado     ResultadoAcceso
  motivo        String?
  contador      Int?
  recorridoId   Int?
  recorrido     RecorridoTransporte? @relation(fields: [recorridoId], references: [id], onDelete: SetNull)
  comedorId     Int?
  comedor       Comedor?        @relation(fields: [comedorId], references: [id], onDelete: SetNull)
  operadorId    Int?
  operador      User?           @relation("AccesoOperador", fields: [operadorId], references: [id], onDelete: SetNull)
  dispositivo   String?
  notificado    Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@unique([credencialId, punto, contador])
  @@index([alumnoId, createdAt])
  @@index([punto, createdAt])
  @@index([resultado])
}

// ============================================================
// RF-07 — AVISOS POR MENSAJERÍA
// ============================================================

enum TipoAviso {
  CAMBIO_HORARIO
  AUSENCIA_PROFESOR
  GENERAL
}

enum CanalMensaje {
  SMS
  WHATSAPP
  EMAIL
}

enum EstadoMensaje {
  PENDIENTE
  ENVIADO
  FALLIDO
  /// El tutor no tiene teléfono cargado: el plan exige avisar por correo.
  SIN_TELEFONO
}

/// Aviso que la Dirección emite a un conjunto de familias.
///
/// El destinatario no se elige a mano: se deriva del curso, la materia o el
/// deporte afectado. Así un cambio de horario llega exactamente a las familias
/// involucradas y a ninguna más.
model AvisoMasivo {
  id          Int       @id @default(autoincrement())
  tipo        TipoAviso
  titulo      String
  cuerpo      String
  /// Alcance del aviso. Al menos uno debe estar presente.
  cursoId     Int?
  curso       Curso?    @relation(fields: [cursoId], references: [id], onDelete: SetNull)
  materiaId   Int?
  materia     Materia?  @relation(fields: [materiaId], references: [id], onDelete: SetNull)
  deporteId   Int?
  deporte     Deporte?  @relation(fields: [deporteId], references: [id], onDelete: SetNull)
  creadoPorId Int?
  creadoPor   User?     @relation("AvisoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  mensajes MensajeEnviado[]

  @@index([tipo, createdAt])
}

/// Un mensaje por destinatario. Queda registrado aunque falle: el plan exige
/// poder demostrar a quién se avisó y a quién no.
model MensajeEnviado {
  id             Int           @id @default(autoincrement())
  avisoId        Int
  aviso          AvisoMasivo   @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  destinatarioId Int
  destinatario   User          @relation("MensajeDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  alumnoId       Int?
  alumno         Alumno?       @relation(fields: [alumnoId], references: [id], onDelete: SetNull)
  telefono       String?
  canal          CanalMensaje
  estado         EstadoMensaje @default(PENDIENTE)
  /// Identificador que devuelve el proveedor externo, para conciliar.
  referenciaExterna String?
  error          String?
  enviadoEn      DateTime?
  createdAt      DateTime      @default(now())

  @@index([avisoId, estado])
  @@index([destinatarioId])
}

// ============================================================
// RF-08 — GEOLOCALIZACIÓN DEL TRANSPORTE
// ============================================================

/// Posición reportada por el dispositivo a bordo del micro.
///
/// Se conserva el histórico en vez de sobrescribir una única fila: permite
/// reconstruir el recorrido de un día puntual si una familia reclama, y es el
/// insumo para analizar demoras.
model PosicionTransporte {
  id           Int                 @id @default(autoincrement())
  recorridoId  Int
  recorrido    RecorridoTransporte @relation(fields: [recorridoId], references: [id], onDelete: Cascade)
  latitud      Float
  longitud     Float
  /// Velocidad en km/h y precisión en metros, si el dispositivo las informa.
  velocidad    Float?
  precision    Float?
  /// Momento en que el dispositivo tomó la posición, que puede diferir del de
  /// recepción si hubo corte de señal y el envío quedó encolado.
  registradoEn DateTime
  dispositivo  String?
  recibidoEn   DateTime            @default(now())

  @@index([recorridoId, registradoEn])
}
