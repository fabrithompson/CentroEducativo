# Formato básico compartido por cualquier editor, sin depender de extensiones
# de VS Code. El hook de pre-commit rechaza lo que esto evita.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
